region                       = ""
namespace                    = ""
runner_namespace             = ""
runner_name                  = "powerlifting-k8s"
runner_repository_url        = ""
github_app_id                = ""
github_app_installation_id   = ""
github_app_private_key       = ""
app_domain                   = ""
auth_domain                  = ""
storage_class                = ""
dataset_bucket               = ""
budget_media_bucket          = ""
discord_client_id            = ""
discord_client_secret        = ""
authentik_client_id          = ""
authentik_client_secret      = ""
jwt_secret                   = ""
internal_api_token           = ""
discord_bot_token            = ""
authentik_bootstrap_email    = ""
authentik_bootstrap_password = ""
authentik_bootstrap_token    = ""
node_name                    = ""
loki_storage_gb              = 10
prometheus_storage_gb        = 10
grafana_storage_gb           = 2
log_retention_days           = 7
metrics_retention_days       = 15
grafana_admin_password       = ""

repositories = {
  services  = ""
  analytics = ""
  rankings  = ""
  analytics_ai = ""
  prompt_cache_api = ""
  analytics_export = ""
  glossary  = ""
  sessions = ""
  program = ""
  competition = ""
  profile = ""
  backend   = ""
  frontend  = ""
}

tables = {
  powerlifting        = ""
  users               = ""
  sessions            = ""
  master_competitions = ""
  user_competitions   = ""
  master_federations  = ""
  user_federations    = ""
  goals               = ""
  budget              = ""
  glossary            = ""
}
llm_domain                   = ""
litellm_providers = {
  chatgpt    = { type = "chatgpt" }
  openrouter = { type = "openrouter" }
}
litellm_models = {
  pl-analysis  = [{ provider = "chatgpt", model = "gpt-6-sol" }]
  pl-standard  = [{ provider = "chatgpt", model = "gpt-5.6-terra" }]
  pl-light     = [{ provider = "chatgpt", model = "gpt-6-luna" }]
  pl-documents = [{ provider = "chatgpt", model = "gpt-6-astra" }]
  pl-background = [{ provider = "openrouter", model = "deepseek/deepseek-v4-flash" }]
  pl-coordinator = [
    { provider = "openrouter", model = "anthropic/claude-sonnet-5" },
    { provider = "openrouter", model = "anthropic/claude-sonnet-4.5" },
  ]
  pl-responder-fast = [{ provider = "openrouter", model = "deepseek/deepseek-v4-flash" }]
  pl-embed          = [{ provider = "openrouter", model = "openai/text-embedding-3-small", mode = "embedding" }]
}
litellm_fallbacks = {
  pl-coordinator    = ["pl-analysis"]
  pl-responder-fast = ["pl-light"]
}
litellm_mcp_servers = {
  sessions      = { url = "http://pl-sessions.powerlifting.svc.cluster.local:8000/mcp" }
  program       = { url = "http://pl-program.powerlifting.svc.cluster.local:8000/mcp" }
  competition   = { url = "http://pl-competition.powerlifting.svc.cluster.local:8000/mcp" }
  profile       = { url = "http://pl-profile.powerlifting.svc.cluster.local:8000/mcp" }
  glossary      = { url = "http://pl-glossary.powerlifting.svc.cluster.local:8000/mcp" }
  templates     = { url = "http://pl-templates.powerlifting.svc.cluster.local:8000/mcp" }
  goals         = { url = "http://pl-goals.powerlifting.svc.cluster.local:8000/mcp" }
  performance   = { url = "http://pl-performance.powerlifting.svc.cluster.local:8000/mcp" }
  lift_profiles = { url = "http://pl-lift-profiles.powerlifting.svc.cluster.local:8000/mcp" }
  weight_log    = { url = "http://pl-weight-log.powerlifting.svc.cluster.local:8000/mcp" }
  federation    = { url = "http://pl-federation.powerlifting.svc.cluster.local:8000/mcp" }
  calculations  = { url = "http://pl-calculations.powerlifting.svc.cluster.local:8000/mcp" }
}
litellm_virtual_key_assistant = ""
litellm_virtual_key_coach     = ""
litellm_admins            = []
