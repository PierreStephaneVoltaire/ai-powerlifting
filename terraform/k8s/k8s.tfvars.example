region                       = ""
namespace                    = ""
runner_namespace             = ""
runner_name                  = "powerlifting-k8s"
runner_repository_url        = ""
github_app_id                = ""
github_app_installation_id   = ""
github_app_private_key       = ""
app_domain                   = ""
auth_domain                  = ""
storage_class                = ""
dataset_bucket               = ""
discord_client_id            = ""
discord_client_secret        = ""
authentik_client_id          = ""
authentik_client_secret      = ""
jwt_secret                   = ""
internal_api_token           = ""
discord_bot_token            = ""
authentik_bootstrap_email    = ""
authentik_bootstrap_password = ""
authentik_bootstrap_token    = ""
node_name                    = ""
loki_storage_gb              = 10
prometheus_storage_gb        = 10
grafana_storage_gb           = 2
log_retention_days           = 7
metrics_retention_days       = 15
grafana_admin_password       = ""

repositories = {
  services  = ""
  analytics = ""
  rankings  = ""
  analytics_ai = ""
  prompt_cache_api = ""
  analytics_export = ""
  glossary  = ""
  sessions = ""
  program = ""
  competition = ""
  profile = ""
  backend   = ""
  frontend  = ""
}

tables = {
  powerlifting        = ""
  users               = ""
  sessions            = ""
  master_competitions = ""
  user_competitions   = ""
  master_federations  = ""
  user_federations    = ""
  goals               = ""
  glossary            = ""
}
llm_domain                   = ""
litellm_providers = {
  chatgpt    = { type = "chatgpt" }
  openrouter = { type = "openrouter" }
}
litellm_models = {
  pl-analysis  = [{ provider = "chatgpt", model = "gpt-6-sol" }]
  pl-standard  = [{ provider = "chatgpt", model = "gpt-5.6-terra" }]
  pl-light     = [{ provider = "chatgpt", model = "gpt-6-luna" }]
  pl-documents = [{ provider = "chatgpt", model = "gpt-6-astra" }]
  pl-background = [{ provider = "openrouter", model = "deepseek/deepseek-v4-flash" }]
  pl-coordinator = [
    { provider = "openrouter", model = "anthropic/claude-sonnet-5" },
    { provider = "openrouter", model = "anthropic/claude-sonnet-4.5" },
  ]
  pl-responder-fast = [{ provider = "openrouter", model = "deepseek/deepseek-v4-flash" }]
  pl-embed          = [{ provider = "openrouter", model = "openai/text-embedding-3-small", mode = "embedding" }]
  pl-strong         = [{ provider = "openrouter", model = "anthropic/claude-opus-4.6" }]
}
litellm_fallbacks = {
  pl-coordinator    = ["pl-analysis"]
  pl-responder-fast = ["pl-light"]
  pl-strong         = ["pl-coordinator"]
}
# litellm_mcp_servers = { custom = { url = "http://example.svc:8000/mcp" } }
litellm_admins            = []
argocd_domain             = ""
argocd_admins             = []
argocd_auto_sync          = false


namespace_service_entry_visibility_enabled = false
external_service_entries_enabled           = false
external_service_entries                   = {}
waypoint_network_policy_enabled            = false
network_policy_ingress_workloads           = []
network_policy_egress_workloads            = []
network_policy_ingress_databases           = []
network_policy_egress_databases            = []
kubernetes_api_cidrs                       = []
