[
  {
    "name": "glossary_add",
    "domain": "glossary",
    "description": "Add a new glossary exercise term for a user. The term dict defines the exercise name, muscle groups, fatigue estimate, and other metadata.",
    "handler": "lambda.pod_glossary.handlers.glossary_add.handler",
    "input_schema": {
      "type": "object",
      "properties": {
        "pk": {
          "type": "string",
          "description": "User partition key. Defaults to env HEALTH_PROGRAM_PK."
        },
        "term": {
          "type": "object",
          "description": "Glossary term dict with exercise metadata.",
          "required": [
            "name"
          ],
          "additionalProperties": true
        },
        "exercise": {
          "type": "object",
          "description": "Legacy alias for the glossary term.",
          "required": [
            "name"
          ],
          "additionalProperties": true
        }
      },
      "anyOf": [
        {
          "required": [
            "term"
          ]
        },
        {
          "required": [
            "exercise"
          ]
        }
      ]
    },
    "result_schema": {
      "type": "object",
      "properties": {
        "status": {
          "const": "added"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "id"
      ],
      "additionalProperties": true
    },
    "execution": "deterministic",
    "ownership": "athlete",
    "legacy": [
      "pod_glossary"
    ]
  },
  {
    "name": "glossary_list_terms",
    "domain": "glossary",
    "description": "List all glossary exercise terms for a user. Scans the templates table for rows with sk beginning with \"glossary#\" and flattens into a list of term summaries.",
    "handler": "lambda.pod_glossary.handlers.glossary_list_terms.handler",
    "input_schema": {
      "type": "object",
      "properties": {
        "pk": {
          "type": "string",
          "description": "User partition key. Defaults to env HEALTH_PROGRAM_PK."
        }
      },
      "required": []
    },
    "result_schema": {
      "type": "object",
      "properties": {
        "terms": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "count": {
          "type": "integer"
        }
      },
      "required": [
        "terms",
        "count"
      ],
      "additionalProperties": true
    },
    "execution": "deterministic",
    "ownership": "athlete",
    "legacy": [
      "pod_glossary"
    ]
  },
  {
    "name": "glossary_set_e1rm",
    "domain": "glossary",
    "description": "Set the estimated 1-rep max (E1RM) for a glossary exercise by ID. The value is stored in kg; method describes how it was derived (e.g. \"epley\", \"brzycki\", \"direct\").",
    "handler": "lambda.pod_glossary.handlers.glossary_set_e1rm.handler",
    "input_schema": {
      "type": "object",
      "properties": {
        "pk": {
          "type": "string",
          "description": "User partition key. Defaults to env HEALTH_PROGRAM_PK."
        },
        "id": {
          "type": "string",
          "description": "Glossary exercise ID."
        },
        "value_kg": {
          "type": "number",
          "description": "E1RM value in kg."
        },
        "method": {
          "type": "string",
          "description": "Method used to derive the E1RM (e.g. \"epley\", \"brzycki\", \"direct\")."
        }
      },
      "required": [
        "id",
        "value_kg"
      ]
    },
    "result_schema": {
      "type": "object",
      "properties": {
        "status": {
          "const": "e1rm_set"
        },
        "id": {
          "type": "string"
        },
        "value_kg": {
          "type": "number"
        }
      },
      "required": [
        "status",
        "id",
        "value_kg"
      ],
      "additionalProperties": true
    },
    "execution": "deterministic",
    "ownership": "athlete",
    "legacy": [
      "pod_glossary"
    ]
  },
  {
    "name": "glossary_update",
    "domain": "glossary",
    "description": "Update an existing glossary exercise term. The term dict replaces the exercise metadata for the given ID.",
    "handler": "lambda.pod_glossary.handlers.glossary_update.handler",
    "input_schema": {
      "type": "object",
      "properties": {
        "pk": {
          "type": "string",
          "description": "User partition key. Defaults to env HEALTH_PROGRAM_PK."
        },
        "term": {
          "type": "object",
          "description": "Updated glossary term dict.",
          "minProperties": 1,
          "additionalProperties": true
        },
        "fields": {
          "type": "object",
          "description": "Fields to merge into the existing term.",
          "minProperties": 1,
          "additionalProperties": true
        }
      },
      "anyOf": [
        {
          "required": [
            "id",
            "term"
          ]
        },
        {
          "required": [
            "id",
            "fields"
          ]
        }
      ]
    },
    "result_schema": {
      "type": "object",
      "properties": {
        "status": {
          "const": "updated"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "id"
      ],
      "additionalProperties": true
    },
    "execution": "deterministic",
    "ownership": "athlete",
    "legacy": [
      "pod_glossary"
    ]
  },
  {
    "name": "exercise_upsert",
    "domain": "glossary",
