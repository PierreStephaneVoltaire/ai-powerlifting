  {
    "name": "program_get",
    "domain": "program",
    "description": "Get a specific program version by its sort key. Returns the full program object with phases, sessions, meta, lift profiles, and competitions. Use this to load a program for display or before modifying it.",
    "handler": "services.handlers.program.program_get.handler",
    "input_schema": {
      "type": "object",
      "properties": {
        "pk": {
          "type": "string",
          "description": "User partition key. Defaults to env HEALTH_PROGRAM_PK."
        },
        "program_sk": {
          "type": "string",
          "description": "Program sort key (e.g. \"program#v3\" or \"program#current\")."
        },
        "block": {
          "type": "string",
          "description": "Optional block id, or \"current\" for the active block."
        },
        "window_start": {
          "type": "string",
          "description": "Inclusive YYYY-MM-DD session and competition window start."
        },
        "window_end": {
          "type": "string",
          "description": "Inclusive YYYY-MM-DD session and competition window end."
        }
      },
      "required": []
    },
    "result_schema": {
      "type": "object",
      "additionalProperties": true
    },
    "execution": "deterministic",
    "ownership": "athlete",
    "legacy": [
      "pod_training_program"
    ]
