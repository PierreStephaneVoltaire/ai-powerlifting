[
  {
    "name": "block_transition",
    "domain": "program",
    "description": "Complete the current block, start a next block, or do both with an idempotent revisioned transition.",
    "handler": "services.handlers.program.block_transition.handler",
    "input_schema": {
      "type": "object",
      "properties": {
        "pk": {
          "type": "string"
        },
        "action": {
          "enum": [
            "complete",
            "start_next",
            "complete_and_start",
            "rename"
          ]
        },
        "block_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "current_name": {
          "type": "string"
        },
        "start_date": {
          "type": "string"
        },
        "week_start_day": {
          "type": "string"
        },
        "start_maxes_kg": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "next_program": {
          "type": "object",
          "properties": {
            "phases": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "sessions": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          },
          "additionalProperties": true
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "action",
        "block_id",
        "expected_revision",
        "idempotency_key"
      ],
      "additionalProperties": true
    },
    "result_schema": {
      "type": "object",
      "required": [
        "action",
        "block_id",
        "revision"
      ],
      "additionalProperties": true
    },
    "execution": "deterministic",
    "ownership": "athlete",
    "legacy": [
      "pod_training_program"
    ]
  },
