        "pk": {
          "type": "string",
          "minLength": 1,
          "description": "Athlete partition key."
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "default": "current",
          "description": "Program version key suffix."
        },
        "session_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "video_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "session_date",
        "video_id"
      ],
      "additionalProperties": false
    },
    "result_schema": {
      "type": "object",
