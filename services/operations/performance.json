      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "sk": {
          "type": "string"
        },
        "squat_kg": {
          "type": [
            "number",
            "null"
          ]
        },
        "bench_kg": {
          "type": [
            "number",
            "null"
          ]
        },
        "deadlift_kg": {
          "type": [
            "number",
            "null"
          ]
        },
        "total_kg": {
          "type": [
            "number",
            "null"
          ]
        },
        "updated_at": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "execution": "deterministic",
