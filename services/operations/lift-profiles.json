          }
        },
        "suggestions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "error": {
          "type": "string"
        }
      },
      "$defs": {
        "score": {
          "type": "object",
          "properties": {
            "score": {
              "type": "integer"
            },
            "max": {
              "type": "integer"
            },
            "notes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "score",
            "max",
            "notes"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "lift",
        "completeness_score",
        "ready_for_coefficient",
        "score_explanation",
        "score_breakdown",
        "missing_details",
        "suggestions"
      ],
      "additionalProperties": false
    },
    "execution": "ai",
    "ownership": "athlete",
    "legacy": [
      "pod_lift_profile_ai"
    ]
