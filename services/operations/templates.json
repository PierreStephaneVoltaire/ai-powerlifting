[
  {
    "name": "template_apply",
    "domain": "templates",
    "description": "Preview applying a template to the athlete program.",
    "handler": "lambda.pod_templates.handlers.template_apply.handler",
    "input_schema": {
      "type": "object",
      "properties": {
        "pk": {
          "type": "string"
        },
        "sk": {
          "type": "string"
        },
        "target": {
          "enum": [
            "new_block",
            "append",
            "replace_incomplete"
          ]
        },
        "block_id": {
          "type": "string"
        },
        "block_name": {
          "type": "string"
        },
        "start_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "week_start_day": {
          "type": "string"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "sk",
        "expected_revision",
        "idempotency_key"
      ],
      "additionalProperties": true
    },
    "result_schema": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "status",
            "preview_sessions",
            "target",
            "start_date",
            "week_start_day"
          ],
          "properties": {
            "status": {
              "const": "ready"
            },
            "preview_sessions": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "target": {
              "type": "string"
            },
            "start_date": {
              "type": "string"
            },
            "week_start_day": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "status",
            "missing_exercises",
            "missing_maxes"
          ],
          "properties": {
            "status": {
              "const": "gate_blocked"
            },
            "missing_exercises": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "missing_maxes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "execution": "deterministic",
    "ownership": "athlete",
    "legacy": [
      "pod_templates"
    ]
  },
