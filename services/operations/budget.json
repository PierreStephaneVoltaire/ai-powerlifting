  {
    "name": "budget_advisor",
    "domain": "budget",
    "description": "Analyze budget spending and competition readiness.",
    "handler": "lambda.pod_budget.handlers.budget_advisor.handler",
    "input_schema": {
      "type": "object",
      "properties": {
        "pk": {
          "type": "string"
        },
        "config": {
          "type": "object",
          "required": [
            "monthly_cap",
            "currency"
          ],
          "properties": {
            "monthly_cap": {
              "type": "number",
              "minimum": 0
            },
            "currency": {
              "type": "string",
              "minLength": 1
            },
            "notes": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": true
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "user_pk",
              "name",
              "category",
              "priority_tier",
              "cost",
              "currency",
              "recurrence",
              "date_precision",
              "start_date",
              "end_date",
              "comp_linked",
              "competition_id",
              "purchased",
              "purchased_date",
              "notes",
              "photo_s3_key",
              "cut_by_ai",
              "created_at",
              "updated_at"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "user_pk": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "priority_tier": {
                "enum": [
                  "MANDATORY",
                  "IMPORTANT",
                  "OPTIONAL"
                ]
              },
              "cost": {
                "type": "number"
              },
              "currency": {
                "type": "string"
              },
              "recurrence": {
                "type": "string"
              },
              "date_precision": {
                "type": "string"
              },
              "start_date": {
                "type": "string"
              },
              "end_date": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "comp_linked": {
                "type": "boolean"
              },
              "competition_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "purchased": {
                "type": "boolean"
              },
              "purchased_date": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "notes": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "photo_s3_key": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "cut_by_ai": {
                "type": "boolean"
              },
              "created_at": {
                "type": "string"
              },
              "updated_at": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "competitions": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "spent_this_month": {
          "type": "number"
        }
      },
      "required": [
        "config",
        "items"
      ]
    },
    "result_schema": {
      "type": "object",
      "properties": {
        "overall_assessment": {
          "type": "string",
          "description": "One sentence summary referencing the monthly cap, current spend, and nearest competition."
        },
        "locked_in": {
          "type": "array",
          "description": "MANDATORY items that cannot be cut, with a brief note on each.",
          "items": {
            "type": "object",
            "properties": {
              "item_id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "note": {
                "type": "string",
                "description": "Brief AI note, e.g. 'Already purchased.' or 'Not marked as purchased yet.'"
              },
              "purchased": {
                "type": "boolean"
              }
            },
            "required": [
              "item_id",
              "name",
              "note",
              "purchased"
            ]
          }
        },
        "suggested_cuts": {
          "type": "array",
          "description": "Ordered OPTIONAL items recommended for cutting, only when over budget. Empty if under budget.",
          "items": {
            "type": "object",
            "properties": {
              "item_id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "cost": {
                "type": "number"
              },
              "reason": {
                "type": "string",
                "description": "Brief, practical, sport-appropriate reason to cut"
              },
              "rank": {
                "type": "integer",
                "description": "1-based ordering, most-recommended cut first"
              }
            },
            "required": [
              "item_id",
              "name",
              "cost",
              "reason",
              "rank"
            ]
          }
        },
        "gaps": {
          "type": "array",
          "description": "Likely-missing expenses based on the competition date and existing items.",
          "items": {
            "type": "object",
            "properties": {
              "description": {
                "type": "string"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "info",
                  "warning"
                ]
              }
            },
            "required": [
              "description",
              "severity"
            ]
          }
        },
        "coach_note": {
          "type": "string",
          "description": "Short paragraph framed for a coach: things to discuss with the athlete. Empty string if not applicable."
        },
        "insufficient_data": {
          "type": "boolean"
        },
        "insufficient_data_reason": {
          "type": "string"
        }
      },
      "required": [
        "overall_assessment",
        "locked_in",
        "suggested_cuts",
        "gaps",
        "coach_note"
      ]
    },
    "execution": "ai",
    "ownership": "athlete",
    "legacy": [
      "pod_budget"
    ]
  },
