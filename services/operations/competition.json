[
  {
    "name": "calculate_attempts",
    "domain": "competition",
    "description": "Calculate three competition attempts for a lift.",
    "handler": "lambda.pod_competition.handlers.calculate_attempts.handler",
    "input_schema": {
      "type": "object",
      "properties": {
        "lift": {
          "type": "string",
          "enum": [
            "squat",
            "bench",
            "deadlift"
          ]
        },
        "opener_kg": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "j1_override": {
          "type": "number",
          "minimum": 0
        },
        "j2_override": {
          "type": "number",
          "minimum": 0
        },
        "last_felt": {
          "type": "string",
          "enum": [
            "hard",
            "medium",
            "easy"
          ]
        },
        "pk": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "lift",
        "opener_kg"
      ],
      "additionalProperties": true
    },
    "result_schema": {
      "type": "object",
      "required": [
        "lift",
        "attempt_1_kg",
        "attempt_2_kg",
        "attempt_3_kg",
        "jumps_used",
        "warnings"
      ],
      "properties": {
        "lift": {
          "type": "string"
        },
        "attempt_1_kg": {
          "type": "number"
        },
        "attempt_2_kg": {
          "type": "number"
        },
        "attempt_3_kg": {
          "type": "number"
        },
        "jumps_used": {
          "type": "object"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "execution": "deterministic",
    "ownership": "athlete",
    "legacy": [
      "pod_competition"
    ]
  },
