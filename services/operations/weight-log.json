[
  {
    "name": "weight_log_get",
    "domain": "weight-log",
    "description": "Get the weight log for a program version, sorted newest first.",
    "handler": "lambda.pod_weight.handlers.weight_log_get.handler",
    "input_schema": {
      "type": "object",
      "properties": {
        "pk": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "result_schema": {
      "$ref": "#/$defs/log",
      "$defs": {
        "log": {
          "type": "object",
          "required": [
            "pk",
            "sk",
            "entries",
            "updated_at"
          ],
          "properties": {
            "pk": {
              "type": "string"
            },
            "sk": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "entries": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "date",
                  "kg"
                ],
                "properties": {
                  "date": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "kg": {
                    "type": "number"
                  }
                },
                "additionalProperties": true
              }
            },
            "updated_at": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      }
    },
    "execution": "deterministic",
    "ownership": "athlete",
    "legacy": [
      "pod_weight"
    ]
  },
