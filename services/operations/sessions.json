  {
    "name": "session_list",
    "domain": "sessions",
    "description": "List the most recent sessions for a user. Returns session summaries sorted by date descending, then by sort key descending. Use limit to cap the number returned.",
    "handler": "services.handlers.sessions.session_list.handler",
    "input_schema": {
      "type": "object",
      "properties": {
        "pk": {
          "type": "string",
          "description": "User partition key. Defaults to env HEALTH_PROGRAM_PK."
        },
        "limit": {
          "type": "integer",
          "description": "Maximum number of sessions to return. Default 50, max 200."
        },
        "program_sk": {
          "type": "string",
          "description": "Program sort key. Defaults to the current program."
        }
      },
      "required": []
    },
    "result_schema": {
      "type": "object",
      "properties": {
        "sessions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "date": {
                "type": "string"
              },
              "completed": {
                "type": "boolean"
              },
              "exercise_count": {
                "type": "integer"
              }
            },
            "required": [
              "date",
              "completed",
              "exercise_count"
            ],
            "additionalProperties": true
          }
        },
        "count": {
          "type": "integer"
        },
        "total": {
          "type": "integer"
        }
      },
      "required": [
        "sessions",
        "count",
        "total"
      ],
      "additionalProperties": true
    },
    "execution": "deterministic",
    "ownership": "athlete",
    "legacy": [
      "pod_sessions"
    ]
  },
