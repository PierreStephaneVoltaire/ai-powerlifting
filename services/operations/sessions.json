[
  {
    "name": "session_create",
    "domain": "sessions",
    "description": "Create a new session for the current program. The session is appended to the program sessions list with the provided session object.",
    "handler": "services.handlers.sessions.session_create.handler",
    "input_schema": {
      "type": "object",
      "properties": {
        "pk": {
          "type": "string",
          "description": "User partition key. Defaults to env HEALTH_PROGRAM_PK."
        },
        "program_sk": {
          "type": "string",
          "description": "Program sort key. Defaults to current."
        },
        "session": {
          "type": "object",
          "description": "Full session object with date, day, week_number, exercises, session_notes."
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "session",
        "expected_revision",
        "idempotency_key"
      ]
    },
    "result_schema": {
      "type": "object",
      "additionalProperties": true
    },
    "execution": "deterministic",
    "ownership": "athlete",
    "legacy": [
      "pod_sessions"
    ]
  },
  {
