  {
    "name": "session_patch",
    "domain": "sessions",
    "description": "Apply a partial patch to a session at a specific date and index. Only the fields in the patch dict are updated; other fields remain unchanged.",
    "handler": "services.handlers.sessions.session_patch.handler",
    "input_schema": {
      "type": "object",
      "properties": {
        "pk": {
          "type": "string",
          "description": "User partition key. Defaults to env HEALTH_PROGRAM_PK."
        },
        "program_sk": {
          "type": "string",
          "description": "Program sort key. Defaults to current."
        },
        "date": {
          "type": "string",
          "description": "Session date (YYYY-MM-DD)."
        },
        "index": {
          "type": "integer",
          "description": "Zero-based index for same-day session ordinals."
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable Session.id used when the legacy date/index has changed."
        },
        "patch": {
          "type": "object",
          "description": "Dict with session fields to update. Allowed keys: completed, session_rpe, body_weight_kg, exercises, session_notes, day, week_number."
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "date",
        "index",
        "patch",
        "expected_revision",
        "idempotency_key"
      ]
    },
    "result_schema": {
      "type": "object",
      "additionalProperties": true
    },
    "execution": "deterministic",
    "ownership": "athlete",
    "legacy": [
      "pod_sessions"
    ]
  },
