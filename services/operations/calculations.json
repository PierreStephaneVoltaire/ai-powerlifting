[
  {
    "name": "lb_to_kg",
    "domain": "calculations",
    "description": "Convert pounds to kilograms. Returns the input lb value and the rounded kg equivalent.",
    "handler": "services.handlers.calculations.lb_to_kg.handler",
    "input_schema": {
      "type": "object",
      "properties": {
        "lb": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Weight in pounds."
        }
      },
      "required": [
        "lb"
      ]
    },
    "result_schema": {
      "type": "object",
      "required": [
        "lb",
        "kg"
      ],
      "properties": {
        "lb": {
          "type": "number"
        },
        "kg": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "execution": "deterministic",
    "ownership": "public",
    "legacy": [
      "pod_calc"
    ]
  },
