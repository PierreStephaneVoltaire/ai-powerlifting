[
  {
    "name": "calculate_attempts",
    "domain": "competition",
    "description": "Calculate three competition attempts for a lift.",
    "handler": "services.handlers.competition.calculate_attempts.handler",
    "input_schema": {
      "type": "object",
      "properties": {
        "lift": {
          "type": "string",
          "enum": [
            "squat",
            "bench",
            "deadlift"
          ]
        },
        "opener_kg": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "j1_override": {
          "type": "number",
          "minimum": 0
        },
        "j2_override": {
          "type": "number",
          "minimum": 0
        },
        "last_felt": {
          "type": "string",
          "enum": [
            "hard",
            "medium",
            "easy"
          ]
        },
        "pk": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "lift",
        "opener_kg"
      ],
      "additionalProperties": true
    },
    "result_schema": {
      "type": "object",
      "required": [
        "lift",
        "attempt_1_kg",
        "attempt_2_kg",
        "attempt_3_kg",
        "jumps_used",
        "warnings"
      ],
      "properties": {
        "lift": {
          "type": "string"
        },
        "attempt_1_kg": {
          "type": "number"
        },
        "attempt_2_kg": {
          "type": "number"
        },
        "attempt_3_kg": {
          "type": "number"
        },
        "jumps_used": {
          "type": "object"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "execution": "deterministic",
    "ownership": "athlete"
  },
  {
    "name": "health_list_competitions",
    "domain": "competition",
    "description": "List or mutate the athlete's directory competition entries.",
    "handler": "services.handlers.competition.health_list_competitions.handler",
    "input_schema": {
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "list",
            "update",
            "complete"
          ]
        },
        "country": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "master_id": {
          "type": "string"
        },
        "patch": {
          "type": "object"
        },
        "results": {
          "type": "object"
        },
        "body_weight_kg": {
          "type": "number"
        },
        "post_meet_report": {},
        "pk": {
          "type": "string",
          "minLength": 1
        },
        "block_id": {
          "type": "string",
          "description": "Training block id; defaults to the active block."
        }
      },
      "additionalProperties": true
    },
    "result_schema": {
      "type": "object",
      "additionalProperties": true
    },
    "execution": "deterministic",
    "ownership": "athlete"
  },
  {
    "name": "health_update_user_competition",
    "domain": "competition",
    "description": "Patch an athlete's directory competition entry.",
    "handler": "services.handlers.competition.health_list_competitions.handler",
    "input_schema": {
      "type": "object",
      "properties": {
        "master_id": {
          "type": "string",
          "minLength": 1
        },
        "patch": {
          "type": "object"
        },
        "pk": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "master_id",
        "patch"
      ],
      "additionalProperties": true
    },
    "result_schema": {
      "type": "object",
      "additionalProperties": true
    },
    "execution": "deterministic",
    "ownership": "athlete"
  },
  {
    "name": "health_complete_user_competition",
    "domain": "competition",
    "description": "Complete an athlete's directory competition entry.",
    "handler": "services.handlers.competition.health_list_competitions.handler",
    "input_schema": {
      "type": "object",
      "properties": {
        "master_id": {
          "type": "string",
          "minLength": 1
        },
        "results": {
          "type": "object"
        },
        "body_weight_kg": {
          "type": "number"
        },
        "post_meet_report": {},
        "pk": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "master_id",
        "results",
        "body_weight_kg"
      ],
      "additionalProperties": true
    },
    "result_schema": {
      "type": "object",
      "additionalProperties": true
    },
    "execution": "deterministic",
    "ownership": "athlete"
  },
  {
    "name": "health_snapshot_competition_projection",
    "domain": "competition",
    "description": "Snapshot projected totals one week before each confirmed or optional competition entry.",
    "handler": "services.handlers.competition.health_snapshot_competition_projection.handler",
    "input_schema": {
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "minLength": 10
        },
        "version": {
          "type": "string"
        },
        "allow_retrospective": {
          "type": "boolean"
        },
        "pk": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "date"
      ],
      "additionalProperties": true
    },
    "result_schema": {
      "type": "object",
      "required": [
        "snapshot_date",
        "updated",
        "competitions"
      ],
      "properties": {
        "snapshot_date": {
          "type": "string"
        },
        "updated": {
          "type": "integer",
          "minimum": 0
        },
        "competitions": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": true
    },
    "execution": "deterministic",
    "ownership": "athlete"
  }
]
