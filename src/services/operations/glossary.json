    "result_schema": {
      "type": "object",
      "properties": {
        "status": {
          "const": "unarchived"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "id"
      ],
      "additionalProperties": true
    },
    "execution": "deterministic",
    "ownership": "athlete"
  },
  {
    "name": "exercise_remove",
    "domain": "glossary",
    "description": "Permanently remove a glossary exercise by ID. This is a hard delete — the exercise is removed from the table.",
    "handler": "services.glossary.exercise_remove.handler",
    "input_schema": {
      "type": "object",
      "properties": {
        "pk": {
          "type": "string",
          "description": "User partition key. Defaults to env HEALTH_PROGRAM_PK."
        },
        "id": {
          "type": "string",
          "description": "Exercise ID to remove."
        }
      },
      "required": [
        "id"
      ]
    },
    "result_schema": {
      "type": "object",
      "properties": {
        "status": {
          "const": "removed"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "id"
      ],
      "additionalProperties": true
    },
    "execution": "deterministic",
    "ownership": "athlete"
  },
  {
    "name": "exercise_search",
    "domain": "glossary",
    "description": "Search glossary exercises by substring across exercise name, muscle groups, and other text fields.",
    "handler": "services.glossary.exercise_search.handler",
    "input_schema": {
      "type": "object",
      "properties": {
        "pk": {
          "type": "string",
          "description": "User partition key. Defaults to env HEALTH_PROGRAM_PK."
        },
        "query": {
          "type": "string",
          "description": "Search substring."
        }
      },
      "required": [
        "query"
      ]
    },
    "result_schema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string"
        },
        "exercises": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "required": [
        "query",
        "exercises"
      ],
      "additionalProperties": true
    },
    "execution": "deterministic",
    "ownership": "athlete"
  },
  {
    "name": "exercise_get_glossary",
    "domain": "glossary",
    "description": "Get the full glossary for a user — all exercises with their metadata, E1RM values, and muscle group assignments.",
    "handler": "services.glossary.exercise_get_glossary.handler",
    "input_schema": {
      "type": "object",
      "properties": {
        "pk": {
          "type": "string",
          "description": "User partition key. Defaults to env HEALTH_PROGRAM_PK."
        }
      }
    },
    "result_schema": {
      "type": "object",
      "properties": {
        "pk": {
          "type": "string"
        },
        "sk": {
          "const": "glossary#v1"
        },
        "exercises": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "updated_at": {
          "type": "string"
        }
      },
      "required": [
        "pk",
        "sk",
        "exercises",
        "updated_at"
      ],
      "additionalProperties": true
    },
    "execution": "deterministic",
    "ownership": "athlete"
  },
  {
    "name": "exercise_set_e1rm",
    "domain": "glossary",
    "description": "Set the estimated 1-rep max for a specific glossary exercise by ID.",
    "handler": "services.glossary.exercise_set_e1rm.handler",
    "input_schema": {
      "type": "object",
      "properties": {
        "pk": {
          "type": "string",
          "description": "User partition key. Defaults to env HEALTH_PROGRAM_PK."
        },
        "id": {
          "type": "string",
          "description": "Exercise ID."
        },
        "value_kg": {
          "type": "number",
          "description": "E1RM value in kg."
        },
        "method": {
          "type": "string",
          "description": "Method used to derive the E1RM."
        }
      },
      "required": [
        "id",
        "value_kg"
      ]
    },
    "result_schema": {
      "type": "object",
      "properties": {
        "status": {
          "const": "e1rm_set"
        },
        "id": {
          "type": "string"
        },
        "value_kg": {
          "type": "number"
        },
        "method": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "id",
        "value_kg",
        "method"
      ],
      "additionalProperties": true
    },
    "execution": "deterministic",
    "ownership": "athlete"
  },
  {
    "name": "glossary_estimate_e1rm",
    "domain": "glossary",
    "description": "glossary estimate e1rm",
    "handler": "services.glossary.glossary_estimate_e1rm.handler",
    "input_schema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "pk": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id"
      ]
    },
    "result_schema": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "estimated",
            "error"
          ]
        },
        "id": {
          "type": "string"
        },
        "estimate": {
          "type": "object",
          "properties": {
            "e1rm_kg": {
              "type": "number"
            },
            "basis": {
              "type": "string"
            }
          },
          "required": [
            "e1rm_kg",
            "basis"
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "status"
      ]
    },
    "execution": "ai",
    "ownership": "athlete"
  },
