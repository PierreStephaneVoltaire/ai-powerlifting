[
  {
    "name": "exercise_upsert",
    "domain": "glossary",
    "description": "Upsert an exercise in the glossary. If the exercise ID exists, it is updated; otherwise a new entry is created.",
    "handler": "services.glossary.exercise_upsert.handler",
    "input_schema": {
      "type": "object",
      "properties": {
        "pk": {
          "type": "string",
          "description": "User partition key. Defaults to env HEALTH_PROGRAM_PK."
        },
        "exercise": {
          "type": "object",
          "description": "Exercise dict with name, muscle groups, and other metadata.",
          "required": [
            "name"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "exercise"
      ]
    },
    "result_schema": {
      "type": "object",
      "properties": {
        "status": {
          "const": "upserted"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "id"
      ],
      "additionalProperties": true
    },
    "execution": "deterministic",
    "ownership": "athlete"
  },
  {
    "name": "exercise_archive",
    "domain": "glossary",
    "description": "Archive a glossary exercise by ID. The exercise is hidden from default views but remains accessible.",
    "handler": "services.glossary.exercise_archive.handler",
    "input_schema": {
      "type": "object",
      "properties": {
        "pk": {
          "type": "string",
          "description": "User partition key. Defaults to env HEALTH_PROGRAM_PK."
        },
        "id": {
          "type": "string",
          "description": "Exercise ID to archive."
        }
      },
      "required": [
        "id"
      ]
    },
    "result_schema": {
      "type": "object",
      "properties": {
        "status": {
          "const": "archived"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "id"
      ],
      "additionalProperties": true
    },
    "execution": "deterministic",
    "ownership": "athlete"
  },
  {
    "name": "exercise_unarchive",
    "domain": "glossary",
    "description": "Unarchive a previously archived glossary exercise, restoring it to default views.",
