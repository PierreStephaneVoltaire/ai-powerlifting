[
  {
    "name": "exercise_upsert",
    "domain": "glossary",
    "description": "Create or update an exercise for the athlete. Changed fields are stored in the athlete's overlay; an unknown exercise becomes a custom exercise that is later promoted to the shared catalog.",
    "input_schema": {
      "type": "object",
      "properties": {
        "pk": {
          "type": "string",
          "description": "User partition key. Defaults to env HEALTH_PROGRAM_PK."
        },
        "exercise": {
          "type": "object",
          "description": "Exercise dict with name, muscle groups, and other metadata.",
          "required": [
            "name"
          ],
          "additionalProperties": true,
          "properties": {
            "lift_transfer": {
              "type": "object",
              "properties": {
                "squat": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "bench": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "deadlift": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "source": {
                  "enum": [
                    "ai",
                    "rule",
                    "user"
                  ]
                },
                "reasoning": {
                  "type": "string"
                }
              },
              "required": [
                "squat",
                "bench",
                "deadlift",
                "source",
                "reasoning"
              ]
            }
          }
        }
      },
      "required": [
        "exercise"
      ]
    },
    "result_schema": {
      "type": "object",
      "properties": {
        "status": {
          "const": "upserted"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "id"
      ],
      "additionalProperties": true
    },
    "execution": "deterministic",
    "ownership": "athlete"
  },
  {
    "name": "exercise_archive",
    "domain": "glossary",
    "description": "Archive an exercise for the athlete. The exercise is hidden from default views but remains accessible.",
    "input_schema": {
      "type": "object",
      "properties": {
        "pk": {
          "type": "string",
          "description": "User partition key. Defaults to env HEALTH_PROGRAM_PK."
        },
        "id": {
          "type": "string",
          "description": "Exercise ID to archive."
        }
      },
      "required": [
        "id"
      ]
    },
    "result_schema": {
      "type": "object",
      "properties": {
        "status": {
          "const": "archived"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "id"
      ],
      "additionalProperties": true
    },
    "execution": "deterministic",
    "ownership": "athlete"
  },
  {
    "name": "exercise_unarchive",
    "domain": "glossary",
    "description": "Unarchive a previously archived exercise, restoring it to default views.",
    "input_schema": {
      "type": "object",
      "properties": {
        "pk": {
          "type": "string",
          "description": "User partition key. Defaults to env HEALTH_PROGRAM_PK."
        },
        "id": {
          "type": "string",
          "description": "Exercise ID to unarchive."
        }
      },
      "required": [
        "id"
      ]
    },
    "result_schema": {
      "type": "object",
      "properties": {
        "status": {
          "const": "unarchived"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "id"
      ],
      "additionalProperties": true
    },
    "execution": "deterministic",
    "ownership": "athlete"
  },
  {
    "name": "exercise_remove",
    "domain": "glossary",
    "description": "Remove an exercise from the athlete's glossary. Shared catalog exercises are hidden for the athlete, not deleted.",
    "input_schema": {
      "type": "object",
      "properties": {
        "pk": {
          "type": "string",
          "description": "User partition key. Defaults to env HEALTH_PROGRAM_PK."
        },
        "id": {
          "type": "string",
          "description": "Exercise ID to remove."
        }
      },
      "required": [
        "id"
      ]
    },
    "result_schema": {
      "type": "object",
      "properties": {
        "status": {
          "const": "removed"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "id"
      ],
      "additionalProperties": true
    },
    "execution": "deterministic",
    "ownership": "athlete"
  },
  {
    "name": "exercise_get_glossary",
    "domain": "glossary",
    "description": "Get the athlete's glossary: every shared catalog exercise (minus hidden ones) plus the athlete's own, with personal overrides, E1RM values, and personal and generic fatigue profiles.",
    "input_schema": {
      "type": "object",
      "properties": {
        "pk": {
          "type": "string",
          "description": "User partition key. Defaults to env HEALTH_PROGRAM_PK."
        }
      }
    },
    "result_schema": {
      "type": "object",
      "properties": {
        "pk": {
          "type": "string"
        },
        "exercises": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "custom": {
                "type": "boolean",
                "description": "True when this athlete created the exercise."
              },
              "archived": {
                "type": "boolean"
              },
              "fatigue_profile": {
                "type": "object",
                "properties": {
                  "axial": {
                    "type": "number"
                  },
                  "neural": {
                    "type": "number"
                  },
                  "peripheral": {
                    "type": "number"
                  },
                  "systemic": {
                    "type": "number"
                  }
                },
                "description": "Personal profile when fatigue_profile_personalized, otherwise the generic one."
              },
              "fatigue_profile_source": {
                "enum": [
                  "ai_generic",
                  "default",
                  "ai_personal",
                  "manual",
                  "ai_estimated"
                ]
              },
              "generic_fatigue_profile": {
                "type": "object",
                "properties": {
                  "axial": {
                    "type": "number"
                  },
                  "neural": {
                    "type": "number"
                  },
                  "peripheral": {
                    "type": "number"
                  },
                  "systemic": {
                    "type": "number"
                  }
                },
                "description": "Shared catalog profile estimated from the exercise definition alone."
              },
              "fatigue_profile_personalized": {
                "type": "boolean"
              },
              "generic_status": {
                "enum": [
                  "pending",
                  "ready",
                  "failed"
                ],
                "description": "State of the shared catalog estimate."
              }
            },
            "required": [
              "id",
              "name"
            ],
            "additionalProperties": true
          }
        },
        "updated_at": {
          "type": "string"
        }
      },
      "required": [
        "pk",
        "exercises",
        "updated_at"
      ],
      "additionalProperties": true
    },
    "execution": "deterministic",
    "ownership": "athlete"
  },
  {
    "name": "exercise_set_e1rm",
    "domain": "glossary",
    "description": "Set the estimated 1-rep max for a glossary exercise by ID, stored for the athlete only.",
    "input_schema": {
      "type": "object",
      "properties": {
        "pk": {
          "type": "string",
          "description": "User partition key. Defaults to env HEALTH_PROGRAM_PK."
        },
        "id": {
          "type": "string",
          "description": "Exercise ID."
        },
        "value_kg": {
          "type": "number",
          "description": "E1RM value in kg."
        },
        "method": {
          "type": "string",
          "description": "Method used to derive the E1RM."
        }
      },
      "required": [
        "id",
        "value_kg"
      ]
    },
    "result_schema": {
      "type": "object",
      "properties": {
        "status": {
          "const": "e1rm_set"
        },
        "id": {
          "type": "string"
        },
        "value_kg": {
          "type": "number"
        },
        "method": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "id",
        "value_kg",
        "method"
      ],
      "additionalProperties": true
    },
    "execution": "deterministic",
    "ownership": "athlete"
  },
  {
    "name": "glossary_estimate_batch",
    "domain": "glossary",
    "description": "Estimate any of fatigue, e1rm, muscles, lift_transfer and text for up to 25 exercises with one AI call and save each exercise individually. Personal fatigue and e1rm go to the athlete; muscles, lift transfer and text go to the catalog entry when there is one, otherwise to the athlete's own exercise. Also queues the shared generic profile when the catalog does not have one yet. Exercises the model omits or answers invalidly are listed in failed without failing the rest.",
    "input_schema": {
      "type": "object",
      "properties": {
        "ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "maxItems": 25
        },
        "aspects": {
          "type": "array",
          "items": {
            "enum": [
              "fatigue",
              "e1rm",
              "muscles",
              "lift_transfer",
              "text"
            ]
          },
          "minItems": 1,
          "maxItems": 5
        },
        "pk": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "ids",
        "aspects"
      ]
    },
    "result_schema": {
      "type": "object",
      "properties": {
        "saved": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "failed": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "reason"
            ]
          }
        }
      },
      "required": [
        "saved",
        "failed"
      ]
    },
    "execution": "ai",
    "ownership": "athlete"
  },
  {
    "name": "glossary_generic_estimate",
    "domain": "glossary",
    "description": "Fill up to 10 pending shared catalog exercises with one AI call (muscles and text when empty, lift transfer, generic fatigue profile) from their definitions alone, saving each exercise individually. Run by the background estimator; no athlete data is used.",
    "input_schema": {
      "type": "object",
      "properties": {
        "ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "maxItems": 10
        },
        "pk": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "ids"
      ]
    },
    "result_schema": {
      "type": "object",
      "properties": {
        "saved": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "failed": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "reason"
            ]
          }
        },
        "skipped": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "saved",
        "failed",
        "skipped"
      ]
    },
    "execution": "ai",
    "ownership": "athlete"
  }
]
