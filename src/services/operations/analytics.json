  {
    "name": "analyze_progression",
    "domain": "analytics",
    "description": "Analyze progression rate for the current program. Loads program+sessions, then calls analytics.progression_rate to compute week-over-week progression trends.",
    "input_schema": {
      "type": "object",
      "properties": {
        "pk": {
          "type": "string",
          "description": "User partition key. Defaults to env HEALTH_PROGRAM_PK."
        },
        "exercise_name": {
          "type": "string",
          "minLength": 1,
          "description": "Exercise name to analyze."
        },
        "window_weeks": {
          "type": "integer",
          "minimum": 1,
          "default": 4,
          "description": "Lookback window in weeks."
        }
      },
      "required": [
        "exercise_name"
      ]
    },
    "result_schema": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string"
        },
        "slope_kg_per_week": {
          "type": "number"
        },
        "kendall_tau": {
          "type": "number"
        },
        "fit_quality": {
          "type": "number"
        },
        "r2": {
          "type": "number"
        },
        "r_squared": {
          "type": "number"
        },
        "points": {
          "type": "array"
        },
        "method": {
          "type": "string"
        },
        "deload_weeks_excluded": {
          "type": "integer"
        }
      },
      "additionalProperties": true
    },
    "execution": "deterministic",
    "ownership": "athlete"
  },
  {
    "name": "analyze_rpe_drift",
    "domain": "analytics",
    "description": "Analyze RPE (rate of perceived exertion) drift for a specific exercise over a window of weeks. Loads program+sessions, then calls analytics.rpe_drift. Uses window_weeks (default 4) to set the lookback period.",
    "input_schema": {
      "type": "object",
      "properties": {
        "pk": {
          "type": "string",
          "description": "User partition key. Defaults to env HEALTH_PROGRAM_PK."
        },
        "exercise_name": {
          "type": "string",
          "minLength": 1,
          "description": "Exercise name to analyze."
        },
        "window_weeks": {
          "type": "integer",
          "minimum": 1,
          "default": 4,
          "description": "Lookback window in weeks."
        }
      },
      "required": [
        "exercise_name"
      ]
    },
    "result_schema": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string"
        },
        "slope": {
          "type": "number"
        },
        "drift_direction": {
          "type": "string"
        },
        "flag": {
          "type": [
            "string",
            "null"
          ]
        },
        "kendall_tau": {
          "type": "number"
        },
        "fit_quality": {
          "type": "number"
        }
      },
      "additionalProperties": true
    },
    "execution": "deterministic",
    "ownership": "athlete"
  },
  {
    "name": "health_suggest_e1rm_multipliers",
    "domain": "analytics",
    "description": "Suggest per lift e1RM multipliers from completed competition results and max history compared with recent session estimates.",
