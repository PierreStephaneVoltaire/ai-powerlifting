[
  {
    "name": "analysis_section",
    "domain": "analytics",
    "description": "Compute a single deterministic weekly analysis section. Loads program+sessions via the ProgramStore layer, fetches glossary via direct DynamoDB, then computes one analysis section (e.g. \"volume\", \"intensity\", \"progression\"). AI section keys (ai_correlation, program_evaluation) are rejected before reaching this core.",
    "input_schema": {
      "type": "object",
      "properties": {
        "pk": {
          "type": "string",
          "description": "User partition key. Defaults to env HEALTH_PROGRAM_PK."
        },
        "program_sk": {
          "type": "string",
          "description": "Program sort key. Defaults to current."
        },
        "block_key": {
          "type": "string",
          "description": "Block key to analyze."
        },
        "section": {
          "type": "string",
          "description": "Analysis section name (e.g. \"volume\", \"intensity\", \"progression\", \"rpe_drift\")."
        },
        "refresh": {
          "type": "boolean",
          "description": "Force recompute instead of using cached value. Default false."
        },
        "program": {
          "type": "object",
          "description": "Program to analyze instead of the stored one."
        },
        "sessions": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Sessions to analyze instead of the program's own."
        },
        "weeks": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "block": {
          "type": "string",
          "default": "current",
          "description": "Block scope; an empty string analyzes every session."
        },
        "window_start": {
          "type": "string"
        },
        "window_end": {
          "type": "string"
        },
        "ref_date": {
          "type": "string"
        },
        "week_start": {
          "type": "integer",
          "minimum": 1
        },
        "week_end": {
          "type": "integer",
          "minimum": 1
        },
        "current_maxes": {
          "type": "object",
          "description": "Squat, bench and deadlift maxes that replace the estimated ones (method becomes provided)."
        },
        "projection_date": {
          "type": "string",
          "description": "Adds overview.requested_projection for a meet on this date."
        }
      }
    },
    "result_schema": {
      "type": "object",
      "properties": {
        "overview": {
          "type": "object"
        },
        "fatigue_readiness": {
          "type": "object"
        },
        "peaking": {
          "type": "object"
        },
        "workload": {
          "type": "object"
        },
        "alerts": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": true
    },
    "execution": "deterministic",
    "ownership": "athlete"
  },
