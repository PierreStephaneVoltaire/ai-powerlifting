{
  "type": "function",
  "function": {
    "name": "report_e1rm_estimates",
    "description": "Report estimated e1RMs for accessory exercises",
    "parameters": {
      "type": "object",
      "properties": {
        "estimates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "exercise": {
                "type": "string"
              },
              "e1rm_kg": {
                "type": "number"
              },
              "ratio": {
                "type": "number"
              },
              "primary_lift_used": {
                "type": "string",
                "enum": [
                  "squat",
                  "bench",
                  "deadlift"
                ]
              },
              "basis": {
                "type": "string"
              },
              "confidence": {
                "type": "string",
                "enum": [
                  "medium",
                  "low"
                ]
              }
            },
            "required": [
              "exercise",
              "e1rm_kg",
              "ratio",
              "primary_lift_used",
              "basis",
              "confidence"
            ]
          }
        }
      },
      "required": [
        "estimates"
      ]
    }
  }
}
