    "result_schema": {
      "type": "object",
      "required": [
        "findings",
        "summary"
      ],
      "properties": {
        "findings": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "properties": {
              "driver_type": {
                "enum": [
                  "exercise",
                  "muscle",
                  "sequence"
                ]
              },
              "driver": {
                "type": "string"
              },
              "lift": {
                "enum": [
                  "squat",
                  "bench",
                  "deadlift"
                ]
              },
              "effect": {
                "enum": [
                  "helps",
                  "hurts",
                  "unclear"
                ]
              },
              "confidence": {
                "enum": [
                  "strong",
                  "moderate",
                  "weak"
                ]
              },
              "evidence": {
                "type": "string"
              },
              "mechanism": {
                "type": "string"
              },
              "action": {
                "type": "string"
              },
              "caveat": {
                "type": "string"
              }
            },
            "required": [
              "driver_type",
              "driver",
              "lift",
              "effect",
              "confidence",
              "evidence",
              "mechanism",
              "action",
              "caveat"
            ]
          }
        },
        "summary": {
          "type": "string"
        },
        "insufficient_data": {
          "type": "boolean"
