  {
    "name": "correlation_analysis",
    "domain": "analytics-ai",
    "description": "Generate an AI report of what helps or hurts Squat, Bench and Deadlift: exercises, muscles and session sequences, each with evidence and one action. Results are reused while the source data is unchanged; refresh forces a new report.",
    "input_schema": {
      "type": "object",
      "properties": {
        "pk": {
          "type": "string",
          "description": "User partition key. Defaults to env HEALTH_PROGRAM_PK."
        },
        "weeks": {
          "type": "integer",
          "description": "Number of weeks to analyze. Default 4."
        },
        "block": {
          "type": "string",
          "description": "Block key to scope the analysis."
        },
        "refresh": {
          "type": "boolean",
          "default": false
