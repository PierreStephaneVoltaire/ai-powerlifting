    "execution": "ai",
    "ownership": "athlete"
  },
  {
    "name": "glossary_estimate_lift_transfer",
    "domain": "glossary",
    "description": "Estimate how much an exercise transfers to the squat, bench and deadlift with AI. With id the result is stored on the shared catalog exercise (or the athlete's own); with an inline exercise it is only returned.",
    "input_schema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "exercise": {
          "type": "object",
          "additionalProperties": true
        },
        "pk": {
          "type": "string",
          "minLength": 1
        }
      },
      "anyOf": [
        {
          "required": [
            "id"
          ]
        },
        {
          "required": [
            "exercise"
          ]
        }
      ]
    },
    "result_schema": {
      "type": "object",
      "properties": {
        "status": {
          "const": "lift_transfer_estimated"
        },
        "id": {
          "type": "string"
        },
        "lift_transfer": {
          "type": "object",
          "properties": {
            "squat": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "bench": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "deadlift": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "source": {
              "enum": [
                "ai",
                "rule",
                "user"
              ]
            },
            "reasoning": {
              "type": "string"
            }
          },
          "required": [
            "squat",
            "bench",
            "deadlift",
            "source",
            "reasoning"
          ]
        }
      },
      "required": [
        "status",
        "lift_transfer"
      ]
    },
    "execution": "ai",
    "ownership": "athlete"
  },
