        }
      },
      "required": [
        "id"
      ]
    },
    "result_schema": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "generic_estimated",
            "skipped"
          ]
        },
        "id": {
          "type": "string"
        },
        "generic_status": {
          "enum": [
            "pending",
            "ready",
            "failed"
          ]
        }
      },
      "required": [
        "status",
        "id",
        "generic_status"
      ]
    },
    "execution": "ai",
    "ownership": "athlete"
  }
]
