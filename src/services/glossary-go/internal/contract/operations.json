    "result_schema": {
      "type": "object",
      "properties": {
        "status": {
          "const": "archived"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "id"
      ],
      "additionalProperties": true
    },
    "execution": "deterministic",
    "ownership": "athlete"
  },
  {
    "name": "exercise_unarchive",
