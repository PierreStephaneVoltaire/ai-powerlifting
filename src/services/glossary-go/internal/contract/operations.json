  {
    "name": "glossary_generate_text",
    "domain": "glossary",
    "description": "Generate the description, how-to and purpose text for an exercise with AI. The result is returned, not stored.",
    "input_schema": {
      "type": "object",
      "properties": {
        "exercise": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "name"
          ]
        },
        "lift_profiles": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "pk": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "exercise"
      ]
    },
    "result_schema": {
      "type": "object",
      "properties": {
        "status": {
          "const": "generated"
        },
        "description": {
          "type": "string"
        },
        "how_to_perform": {
          "type": "string"
        },
        "why_do_it": {
          "type": "string"
        }
      },
      "required": [
        "status"
      ]
    },
    "execution": "ai",
    "ownership": "athlete"
  },
  {
    "name": "glossary_generic_estimate",
    "domain": "glossary",
    "description": "Fill a pending shared catalog exercise (muscles and text when empty, lift transfer, generic fatigue profile) from its definition alone. Run by the background estimator; no athlete data is used.",
    "input_schema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "pk": {
          "type": "string",
