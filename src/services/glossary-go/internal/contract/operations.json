        "generic_fatigue_profile": {
          "type": "object",
          "properties": {
            "axial": {
              "type": "number"
            },
            "neural": {
              "type": "number"
            },
            "peripheral": {
              "type": "number"
            },
            "systemic": {
              "type": "number"
            }
          }
        }
