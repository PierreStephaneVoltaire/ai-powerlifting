        "status": {
          "const": "fatigue_estimated"
        },
        "id": {
          "type": "string"
        },
        "profile": {
          "type": "object",
          "properties": {
            "axial": {
              "type": "number"
            },
            "neural": {
              "type": "number"
            },
            "peripheral": {
              "type": "number"
            },
            "systemic": {
              "type": "number"
            }
          }
        },
        "fatigue_profile": {
          "type": "object",
          "properties": {
            "axial": {
              "type": "number"
            },
            "neural": {
              "type": "number"
            },
            "peripheral": {
              "type": "number"
            },
            "systemic": {
              "type": "number"
            }
          }
        },
        "reasoning": {
          "type": [
            "string",
