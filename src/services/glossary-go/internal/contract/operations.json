[
  {
    "name": "exercise_upsert",
    "domain": "glossary",
    "description": "Create or update an exercise for the athlete. Changed fields are stored in the athlete's overlay; an unknown exercise becomes a custom exercise that is later promoted to the shared catalog.",
    "input_schema": {
      "type": "object",
      "properties": {
        "pk": {
          "type": "string",
          "description": "User partition key. Defaults to env HEALTH_PROGRAM_PK."
        },
        "exercise": {
          "type": "object",
          "description": "Exercise dict with name, muscle groups, and other metadata.",
          "required": [
            "name"
          ],
          "additionalProperties": true,
          "properties": {
            "lift_transfer": {
              "type": "object",
              "properties": {
                "squat": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "bench": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "deadlift": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "source": {
                  "enum": [
                    "ai",
                    "rule",
                    "user"
                  ]
                },
                "reasoning": {
                  "type": "string"
                }
              },
              "required": [
                "squat",
                "bench",
                "deadlift",
                "source",
                "reasoning"
              ]
            }
          }
        }
      },
      "required": [
        "exercise"
      ]
    },
    "result_schema": {
      "type": "object",
      "properties": {
        "status": {
          "const": "upserted"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "id"
      ],
      "additionalProperties": true
    },
    "execution": "deterministic",
    "ownership": "athlete"
  },
  {
