      ]
    },
    "result_schema": {
      "type": "object",
      "properties": {
        "status": {
          "const": "unarchived"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "id"
      ],
      "additionalProperties": true
    },
    "execution": "deterministic",
    "ownership": "athlete"
  },
  {
    "name": "exercise_remove",
    "domain": "glossary",
    "description": "Remove an exercise from the athlete's glossary. Shared catalog exercises are hidden for the athlete, not deleted.",
    "input_schema": {
      "type": "object",
      "properties": {
        "pk": {
          "type": "string",
          "description": "User partition key. Defaults to env HEALTH_PROGRAM_PK."
        },
        "id": {
          "type": "string",
          "description": "Exercise ID to remove."
        }
      },
      "required": [
        "id"
      ]
    },
    "result_schema": {
      "type": "object",
      "properties": {
        "status": {
          "const": "removed"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "id"
      ],
      "additionalProperties": true
    },
    "execution": "deterministic",
    "ownership": "athlete"
  },
  {
    "name": "exercise_get_glossary",
    "domain": "glossary",
    "description": "Get the athlete's glossary: every shared catalog exercise (minus hidden ones) plus the athlete's own, with personal overrides, E1RM values, and personal and generic fatigue profiles.",
    "input_schema": {
      "type": "object",
      "properties": {
        "pk": {
          "type": "string",
          "description": "User partition key. Defaults to env HEALTH_PROGRAM_PK."
        }
      }
    },
    "result_schema": {
      "type": "object",
      "properties": {
        "pk": {
          "type": "string"
        },
        "exercises": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "custom": {
                "type": "boolean",
                "description": "True when this athlete created the exercise."
              },
              "archived": {
                "type": "boolean"
              },
              "fatigue_profile": {
                "type": "object",
                "properties": {
                  "axial": {
                    "type": "number"
                  },
                  "neural": {
                    "type": "number"
                  },
                  "peripheral": {
                    "type": "number"
                  },
                  "systemic": {
                    "type": "number"
                  }
                },
                "description": "Personal profile when fatigue_profile_personalized, otherwise the generic one."
              },
              "fatigue_profile_source": {
                "enum": [
                  "ai_generic",
                  "default",
                  "ai_personal",
                  "manual",
                  "ai_estimated"
                ]
              },
              "generic_fatigue_profile": {
                "type": "object",
                "properties": {
                  "axial": {
                    "type": "number"
                  },
                  "neural": {
                    "type": "number"
                  },
                  "peripheral": {
                    "type": "number"
                  },
                  "systemic": {
                    "type": "number"
                  }
                },
                "description": "Shared catalog profile estimated from the exercise definition alone."
              },
              "fatigue_profile_personalized": {
                "type": "boolean"
              },
              "generic_status": {
                "enum": [
                  "pending",
                  "ready",
                  "failed"
                ],
                "description": "State of the shared catalog estimate."
              }
            },
            "required": [
              "id",
              "name"
            ],
            "additionalProperties": true
          }
        },
        "updated_at": {
          "type": "string"
        }
      },
      "required": [
        "pk",
        "exercises",
        "updated_at"
      ],
      "additionalProperties": true
    },
    "execution": "deterministic",
    "ownership": "athlete"
  },
  {
    "name": "exercise_set_e1rm",
    "domain": "glossary",
    "description": "Set the estimated 1-rep max for a glossary exercise by ID, stored for the athlete only.",
    "input_schema": {
      "type": "object",
      "properties": {
        "pk": {
          "type": "string",
          "description": "User partition key. Defaults to env HEALTH_PROGRAM_PK."
        },
        "id": {
          "type": "string",
          "description": "Exercise ID."
        },
        "value_kg": {
          "type": "number",
          "description": "E1RM value in kg."
        },
        "method": {
          "type": "string",
          "description": "Method used to derive the E1RM."
        }
      },
      "required": [
        "id",
        "value_kg"
      ]
    },
    "result_schema": {
      "type": "object",
      "properties": {
        "status": {
          "const": "e1rm_set"
        },
        "id": {
          "type": "string"
        },
        "value_kg": {
          "type": "number"
        },
        "method": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "id",
        "value_kg",
        "method"
      ],
      "additionalProperties": true
    },
    "execution": "deterministic",
    "ownership": "athlete"
  },
  {
    "name": "glossary_estimate_e1rm",
    "domain": "glossary",
    "description": "Estimate the athlete's 1-rep max for an exercise from their maxes, lift profiles and past sessions. Personal to the athlete.",
    "input_schema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "pk": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id"
      ]
    },
    "result_schema": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "estimated",
            "error"
          ]
        },
        "id": {
          "type": "string"
        },
        "estimate": {
          "type": "object",
          "properties": {
            "e1rm_kg": {
              "type": "number"
            },
            "basis": {
              "type": "string"
            }
          },
          "required": [
            "e1rm_kg",
            "basis"
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "status"
      ]
    },
    "execution": "ai",
    "ownership": "athlete"
  },
  {
